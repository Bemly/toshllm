+    const int64_t rk2 = neq2/nek2;
+
+    float scale = 1.0f;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+
+    const int32_t target = ggml_get_op_params_i32(dst, 5);
