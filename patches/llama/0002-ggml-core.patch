+                    const float * qr = (const float *) ((const char *) q->data      + iq1*nbq1 + iq2*nbq2 + ik3*nbq3);
+                    const float * gr = (const float *) ((const char *) grad_o->data + iq2*nbg1 + iq1*nbg2 + ik3*nbg3);
