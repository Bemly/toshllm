+                        mu(n_embd, k, su, ur, av);
+                        for (int t = 0; t < k; ++t) finish(i + t, r, sg[t], su[t]);
+                        i += k;
+                    }
+                }
+                for (; i < i1; ++i) {
+                    const void * a = act_q.data() + (size_t) misses[i].t*act_q_row;
+                    float sg, su;
+                    tt_gate->vec_dot(n_embd, &sg, 0, gr, 0, a, 0, 1);
+                    tt_up  ->vec_dot(n_embd, &su, 0, ur, 0, a, 0, 1);
+                    finish(i, r, sg, su);
+                }
+            }
+        }
