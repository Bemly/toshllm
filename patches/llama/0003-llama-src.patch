+            }
+        }
+    }
+    gf_res_prev_active = nullptr;
+    gf_res_alt_active  = nullptr;
+    ggml_backend_sched_reset_shape_slot(sched.get(), 0);
+    ggml_backend_sched_reset_shape_slot(sched.get(), 1);
+    shape_slots_filled = 0;
